<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DictionaryApp.MainPage"
             BackgroundColor="#f4f4f9">

    <ContentPage.Resources>
        <!-- Button Style for Primary Button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#4CAF50"/>
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="12, 8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="WidthRequest" Value="250"/>
            <Setter Property="HorizontalOptions" Value="Center"/>
            <Setter Property="HeightRequest" Value="50"/>
        </Style>

        <!-- Style for Alphabet Buttons -->
        <Style x:Key="LetterButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#2196F3"/>
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="WidthRequest" Value="40"/>
            <Setter Property="HeightRequest" Value="40"/>
        </Style>

        <!-- Style for SearchBar -->
        <Style x:Key="SearchBarStyle" TargetType="SearchBar">
            <Setter Property="BackgroundColor" Value="#fff"/>
            <Setter Property="HeightRequest" Value="45"/>
            
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalOptions" Value="FillAndExpand"/>
        </Style>

        <!-- Label Style for Title -->
        <Style x:Key="TitleLabel" TargetType="Label">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="TextColor" Value="#333"/>
            <Setter Property="HorizontalOptions" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <!-- Style for Results Label -->
        <Style x:Key="NoResultsLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="TextColor" Value="Red"/>
            <Setter Property="HorizontalOptions" Value="Center"/>
            <Setter Property="IsVisible" Value="False"/>
        </Style>
    </ContentPage.Resources>

    <VerticalStackLayout Padding="20" Spacing="25">
        <!-- App Title -->
        <Label Text="Welcome to Dictionary App!"
               Style="{StaticResource TitleLabel}"/>

        <!-- Search Bar -->
        <SearchBar Placeholder="Search for a word..."
                   TextChanged="OnSearchTextChanged"
                   Style="{StaticResource SearchBarStyle}"/>

        <!-- Alphabet Buttons -->
        <CollectionView ItemsSource="{Binding Alphabet}" SelectionMode="None">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Horizontal" Span="6"/>
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Button Text="{Binding}" Style="{StaticResource LetterButton}"
                            Clicked="OnLetterClicked"/>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Search Results -->
        <ListView x:Name="WordListView"
                  IsVisible="False"
                  ItemSelected="OnWordSelected"
                  HasUnevenRows="True">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextCell Text="{Binding wordName}" Detail="{Binding rootName.name}"/>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- No Results Label -->
        <Label x:Name="NoResultsLabel"
               Text="No results found"
               Style="{StaticResource NoResultsLabelStyle}"/>

        <!-- Navigation Button to Dictionary Page -->
        <Button Text="Go to Dictionary Page"
                Clicked="OnNavigateToDictionary"
                Style="{StaticResource PrimaryButton}"/>

        <!-- Navigation Button to Upload Page -->
        <Button Text="Upload Files"
                Clicked="OnNavigateToUploadPage"
                Style="{StaticResource PrimaryButton}"/>
    </VerticalStackLayout>

</ContentPage>
