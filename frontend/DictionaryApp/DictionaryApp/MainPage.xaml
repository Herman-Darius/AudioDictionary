<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DictionaryApp.MainPage"
             BackgroundColor="#FDF6EC"
             NavigationPage.HasNavigationBar="False"
             Appearing="OnPageAppearing">

    <ContentPage.Resources>
        <Style x:Key="RusticHeader" TargetType="Label">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="FontFamily" Value="Serif"/>
            <Setter Property="TextColor" Value="#4B2E06"/>
            <Setter Property="HorizontalOptions" Value="Center"/>
        </Style>

        <Style x:Key="SearchBarStyle" TargetType="SearchBar">
            <Setter Property="BackgroundColor" Value="#FAF1E6"/>
            <Setter Property="TextColor" Value="#3E2603"/>
            <Setter Property="PlaceholderColor" Value="#8B7E74"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HeightRequest" Value="50"/>
            <Setter Property="FontFamily" Value="Serif"/>
        </Style>

        <Style x:Key="LetterButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#A9743F"/>
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="FontFamily" Value="Serif"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="HeightRequest" Value="50"/>
            <Setter Property="WidthRequest" Value="50"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="Black" Offset="1,2" Radius="4" Opacity="0.2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#8B4513"/>
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontFamily" Value="RusticSerif"/>
            <Setter Property="Padding" Value="12, 8"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="WidthRequest" Value="250"/>
            <Setter Property="HorizontalOptions" Value="Center"/>
            <Setter Property="HeightRequest" Value="50"/>
        </Style>
    </ContentPage.Resources>

    <Grid>
        <Image Source="rustic_wood_bg.jpg"
               Aspect="AspectFill"
               Opacity="0.25"
               VerticalOptions="FillAndExpand"
               HorizontalOptions="FillAndExpand"
               ZIndex="0" />

        <ScrollView x:Name="MainContent" ZIndex="1" Opacity="0">
            <VerticalStackLayout Padding="20" Spacing="20">
                <Grid x:Name="OfflineBanner"
                      BackgroundColor="DarkRed"
                      Padding="10"
                      IsVisible="False"
                      Opacity="0"
                      HeightRequest="40"
                      VerticalOptions="Start"
                      HorizontalOptions="FillAndExpand"
                      ZIndex="100">

                    <Label Text="Aplicația este temporar offline"
                           TextColor="White"
                           FontSize="16"
                           FontAttributes="Bold"
                           FontFamily="Serif"
                           VerticalTextAlignment="Center"
                           HorizontalTextAlignment="Center" />
                </Grid>



                <Label Text="Răsfoiește Vorbele" Style="{StaticResource RusticHeader}" />

                <Grid ColumnDefinitions="*,Auto" Padding="10,5" Margin="0,0,0,10">
                    <SearchBar x:Name="SearchBarInstance"
                               Placeholder="Caută un cuvânt..."
                               Style="{StaticResource SearchBarStyle}"
                               TextChanged="OnSearchTextChanged"
                               Grid.Column="0"/>
                    <ActivityIndicator x:Name="SearchLoadingIndicator"
                                       Grid.Column="1"
                                       IsRunning="False"
                                       IsVisible="False"
                                       WidthRequest="25"
                                       HeightRequest="25"
                                       VerticalOptions="Center"
                                       Color="#8B4513"/>
                </Grid>

                <Button x:Name="ToggleAlphabetButton"
                        Text="▲ Ascunde butoanele"
                        FontSize="16"
                        FontAttributes="Bold"
                        FontFamily="Serif"
                        BackgroundColor="#E8D8C3"
                        TextColor="#4B2E06"
                        CornerRadius="10"
                        Clicked="OnToggleAlphabetClicked"
                        HorizontalOptions="Center"
                        WidthRequest="200"
                        Margin="0,10,0,0"/>

                <StackLayout x:Name="AlphabetContainer" IsVisible="true" HorizontalOptions="Center">
                    <Grid ColumnSpacing="5" RowSpacing="5" Padding="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Rand 0 -->
                        <Button Text="ă" Style="{StaticResource LetterButton}" Grid.Row="0" Grid.Column="0" Clicked="OnLetterClicked"/>
                        <Button Text="â" Style="{StaticResource LetterButton}" Grid.Row="0" Grid.Column="1" Clicked="OnLetterClicked"/>
                        <Button Text="î" Style="{StaticResource LetterButton}" Grid.Row="0" Grid.Column="2" Clicked="OnLetterClicked"/>
                        <Button Text="ș" Style="{StaticResource LetterButton}" Grid.Row="0" Grid.Column="3" Clicked="OnLetterClicked"/>
                        <Button Text="ț" Style="{StaticResource LetterButton}" Grid.Row="0" Grid.Column="4" Clicked="OnLetterClicked"/>
                        <Button Text="ď" Style="{StaticResource LetterButton}" Grid.Row="0" Grid.Column="5" Clicked="OnLetterClicked"/>

                        <!-- Rand 1 -->
                        <Button Text="ę" Style="{StaticResource LetterButton}" Grid.Row="1" Grid.Column="0" Clicked="OnLetterClicked"/>
                        <Button Text="ň" Style="{StaticResource LetterButton}" Grid.Row="1" Grid.Column="1" Clicked="OnLetterClicked"/>
                        <Button Text="ǫ" Style="{StaticResource LetterButton}" Grid.Row="1" Grid.Column="2" Clicked="OnLetterClicked"/>
                        <Button Text="ó" Style="{StaticResource LetterButton}" Grid.Row="1" Grid.Column="3" Clicked="OnLetterClicked"/>
                        <Button Text="ť" Style="{StaticResource LetterButton}" Grid.Row="1" Grid.Column="4" Clicked="OnLetterClicked"/>
                    </Grid>
                </StackLayout>
                
                <CollectionView x:Name="WordListView"
                                IsVisible="False"
                                SelectionMode="Single"
                                SelectionChanged="OnWordSelected"
                                Margin="10,20,10,0">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Background="#FFF9F4"
                                Stroke="#D3BFA6"
                                StrokeThickness="1"
                                Padding="12"
                                Margin="6"
                                HorizontalOptions="FillAndExpand"
                                VerticalOptions="Center"
                                StrokeShape="RoundRectangle 16">

                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding wordName}"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="#4B2E06"
                                           FontFamily="RusticSerif"/>
                                    <Label Text="{Binding definition}"
                                           FontSize="15"
                                           FontAttributes="Italic"
                                           TextColor="#6E5841"
                                           FontFamily="RusticSerif"/>
                                </VerticalStackLayout>

                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label x:Name="NoResultsLabel"
                       Text="No results found"
                       FontSize="18"
                       TextColor="DarkRed"
                       FontFamily="Serif"
                       HorizontalOptions="Center"
                       IsVisible="False" />
                <Image x:Name="NoResultsImage"
                       Source="no_results.png"
                       WidthRequest="220"
                       HeightRequest="220"
                       Margin="0,20,0,0"
                       IsVisible="False"
                       HorizontalOptions="Center" />
                <Label x:Name="NoResultsMessage"
                   Text="Nicio vorbă găsită. Încearcă o literă sau alt cuvânt."
                   FontSize="16"
                   TextColor="#8B4513"
                   FontFamily="Serif"
                   HorizontalOptions="Center"
                   IsVisible="False"
                   Margin="20,10" />

                <Button Text="Upload Files"
                        Clicked="OnNavigateToUploadPage"
                        IsVisible="False"
                        Style="{StaticResource PrimaryButton}" />
            </VerticalStackLayout>
        </ScrollView>

        <ImageButton
            x:Name="InfoButton"
            Source="information_icon.png"
            BackgroundColor="Transparent"
            WidthRequest="48"
            HeightRequest="48"
            Padding="10"
            CornerRadius="24"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="20"
            Clicked="OnInfoClicked"
            ZIndex="10" />
    </Grid>
</ContentPage>
