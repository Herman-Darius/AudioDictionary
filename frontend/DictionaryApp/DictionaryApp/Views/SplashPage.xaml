<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DictionaryApp.Views.SplashPage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#FDF6EC">

    <ContentPage.Resources>
        <Style x:Key="RusticMessageStyle" TargetType="Label">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="TextColor" Value="#5D3A00"/>
            <Setter Property="FontFamily" Value="RusticSerif"/>
            <Setter Property="HorizontalOptions" Value="Center"/>
            <Setter Property="TextTransform" Value="None"/>
        </Style>
    </ContentPage.Resources>

    <Grid>
        <Image Source="rustic_wood_bg.jpg"
               Aspect="AspectFill"
               Opacity="0.3"
               VerticalOptions="FillAndExpand"
               HorizontalOptions="FillAndExpand"
               ZIndex="0" />
        
        <Image Source="leaves.gif"
               Aspect="AspectFill"
               Opacity="0.4"
               VerticalOptions="FillAndExpand"
               HorizontalOptions="FillAndExpand"
               ZIndex="1" />

        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" ZIndex="2"
                             Spacing="20" Padding="30">
            <Image Source="logo.png" WidthRequest="160" HeightRequest="160" />
            <ActivityIndicator IsRunning="True"
                               Color="#8B4513"
                               WidthRequest="60"
                               HeightRequest="60" />
            <Label x:Name="LoadingMessageLabel"
                   Text="Se pregătesc vorbele..."
                   Opacity="1"
                   Style="{StaticResource RusticMessageStyle}" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
