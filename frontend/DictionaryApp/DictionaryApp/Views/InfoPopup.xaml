<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:Class="DictionaryApp.Views.InfoPopup">

    <ScrollView Padding="20" BackgroundColor="#FDF6EC">
        <VerticalStackLayout Spacing="15">

            <Label Text="📜 Reguli de pronunție:" 
                   FontAttributes="Bold" 
                   FontSize="18" 
                   TextColor="#4B2E06" />

            <Label Text="cὶ - se pronunță ca grupul ci, dar înlocuind i cu î;" 
                   FontSize="14" 
                   TextColor="#5D3A00" />
            <Label Text="ď , Ď - se pronunță aproximativ ca în grupul ghi înlocuind g cu d;" 
                   FontSize="14" 
                   TextColor="#5D3A00" />
            <Label Text="ę, Ę - se pronunță e cu gura deschisă ca pentru litera a;" 
                   FontSize="14" 
                   TextColor="#5D3A00" />
            <Label Text="í, Í - se pronunță ca un i lung (ex: în cuvântul copii);" 
                   FontSize="14" 
                   TextColor="#5D3A00" />
            <Label Text="ň, Ň - se pronunță n cu toată limba lipită de cerul gurii;" 
                   FontSize="14" 
                   TextColor="#5D3A00" />
            <Label Text="ǫ, Ǫ - se pronunță o cu gura deschisă ca pentru litera a;" 
                   FontSize="14" 
                   TextColor="#5D3A00" />
            <Label Text="ó - este un o mai lung;" 
                   FontSize="14" 
                   TextColor="#5D3A00" />
            <Label Text="ť, Ť - se pronunță t cu toată limba lipită de cerul gurii;" 
                   FontSize="14" 
                   TextColor="#5D3A00" />
            <Label Text="ú - este un u mai lung;" 
                   FontSize="14" 
                   TextColor="#5D3A00" />

            <Label Text="📚 Reguli de editare:" 
                   FontAttributes="Bold" 
                   FontSize="18" 
                   TextColor="#4B2E06"
                   Margin="0,10,0,0" />

            <Label Text="• Substantive: cu litere aldine forma populară, litere normale forma literară. Paranteză: pluralul, cu ~ pentru rădăcina comună." 
                   FontSize="14" 
                   TextColor="#5D3A00" />
            <Label Text="Exemple: casă (~ăsi) - casă (~e); cucuruz (~) - știulete (~ți)." 
                   FontSize="14" 
                   TextColor="#5D3A00" />

            <Label Text="• Adjective/Adverbe: forma populară (bold), apoi literară. Paranteză: terminațiile (fem. sg., masc. pl., fem. pl.)" 
                    FontSize="14" 
                    TextColor="#5D3A00" />
            <Label Text="Exemple: băncuros (~ǫsă, ~oși, ~ǫse) - glumeț (~ață, ~ți, ~țe);" 
                    FontSize="14" 
                    TextColor="#5D3A00" />
            <Label Text="bugăt (~tă, ~ț, ~ťe) - destul (~lă, ~i, ~le);" 
                   FontSize="14" 
                   TextColor="#5D3A00" />
            <Label Text="lęzňe (~, ~, ~) - ieftin (~ă, ~i, ~e);" 
                   FontSize="14" 
                   TextColor="#5D3A00" />
            
            <Button Text="Închide"
                    HorizontalOptions="Center"
                    BackgroundColor="#A9743F"
                    TextColor="White"
                    Clicked="OnCloseClicked"
                    WidthRequest="150"/>
        </VerticalStackLayout>
    </ScrollView>
</toolkit:Popup>
