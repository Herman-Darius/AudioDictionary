<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="DictionaryApp.Views.WordDetailsPage"
    Title="Word Details"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#FDF6EC">

    <ContentPage.Resources>
        <Style x:Key="RusticHeader" TargetType="Label">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="TextColor" Value="#5D3A00"/>
            <Setter Property="FontFamily" Value="serif"/>
            <Setter Property="HorizontalOptions" Value="FillAndExpand"/>
            <Setter Property="LineBreakMode"   Value="WordWrap"/>
        </Style>



        <Style x:Key="RusticSubText" TargetType="Label">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="TextColor" Value="#6E5841"/>
            <Setter Property="FontAttributes" Value="Italic"/>
            <Setter Property="HorizontalOptions" Value="Fill"/>
            <Setter Property="LineBreakMode" Value="WordWrap"/>
        </Style>

        <Style x:Key="RusticSectionHeader" TargetType="Label">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="TextColor" Value="#8B4513"/>
            <Setter Property="Margin" Value="0,15,0,5"/>
        </Style>

        <Style x:Key="RusticButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#A9743F"/>
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style x:Key="PhraseContainer" TargetType="Frame">
            <Setter Property="BackgroundColor" Value="#FFF9F0"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="HasShadow" Value="True"/>
        </Style>

        <Style x:Key="RusticPhraseText" TargetType="Label">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="serif"/>
            <Setter Property="TextColor" Value="#4B2E06"/>
            <Setter Property="LineHeight" Value="1.3"/>
        </Style>
    </ContentPage.Resources>

    <Grid>
        <Image Source="rustic_wood_bg.jpg"
               Aspect="AspectFill"
               Opacity="0.2"
               VerticalOptions="FillAndExpand"
               HorizontalOptions="FillAndExpand"
               ZIndex="0"/>
        <Image Source="leaves.gif"
               Aspect="AspectFill"
               Opacity="0.4"
               VerticalOptions="FillAndExpand"
               HorizontalOptions="FillAndExpand"
               ZIndex="1"/>
        <ActivityIndicator x:Name="LoadingIndicator"
                           IsRunning="False"
                           IsVisible="False"
                           Color="#8B4513"
                           VerticalOptions="Center"
                           HorizontalOptions="Center"
                           WidthRequest="80"
                           HeightRequest="80"
                           ZIndex="2"/>

        <ScrollView x:Name="MainContent" Opacity="0" ZIndex="3">
            <VerticalStackLayout Padding="20" Spacing="16">
                <Grid ColumnDefinitions="*, Auto"
                      RowDefinitions="Auto, Auto, Auto"
                      Margin="0,0,0,10">

                    <StackLayout Grid.Row="0"
                       Grid.Column="0"
                       Orientation="Horizontal"
                       Spacing="6"
                       VerticalOptions="Center">
                        <Label x:Name="WordLabel"
                           Style="{StaticResource RusticHeader}"
                           LineBreakMode="WordWrap">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCopyWordTapped" />
                            </Label.GestureRecognizers>
                            
                        </Label>
                        <Label x:Name="LeafLabel"
                           Text="🍂"
                           FontSize="18"
                           Opacity="0"
                           TranslationY="0"
                           VerticalOptions="Start"/>
                    </StackLayout>

                    <Label x:Name="DefinitionLabel"
                         Grid.Row="1"
                         Grid.Column="0"
                         Style="{StaticResource RusticSubText}"
                         Margin="2,4,0,0"/>

                    <ImageButton Grid.Row="2"
                       Grid.Column="0"
                       Source="speaker_icon.png"
                       WidthRequest="36"
                       HeightRequest="36"
                       BackgroundColor="#EEE5D5"
                       CornerRadius="10"
                       Padding="4"
                       BorderColor="#A67C52"
                       BorderWidth="1"
                       Aspect="AspectFit"
                       Margin="0,8,0,0"
                       HorizontalOptions="Start"
                       Clicked="OnPlayWordAudioClicked"/>

                    <Image Grid.Row="0"
                         Grid.RowSpan="3"
                         Grid.Column="1"
                         x:Name="WordImage"
                         WidthRequest="140"
                         HeightRequest="140"
                         Margin="10,0,0,0"
                         Aspect="AspectFit"
                         BackgroundColor="#FFF2E0"
                         Source="default_image.jpg"/>
                </Grid>





                <Label Text="Exemple de fraze" Style="{StaticResource RusticSectionHeader}" />
                <StackLayout x:Name="PhrasesStackLayout" />

                <Grid Padding="10" HorizontalOptions="Start" VerticalOptions="End">
                    <Button Text="← Pagina Principală"
                        Clicked="OnGoToMainPageClicked"
                        BackgroundColor="#A9743F"
                        TextColor="White"
                        FontSize="16"
                        CornerRadius="10"
                        FontFamily="Serif"
                        Padding="12,6"
                        WidthRequest="180"
                        HorizontalOptions="Start"
                        />
                </Grid>

            </VerticalStackLayout>
        </ScrollView>
        <Label x:Name="CopyToastLabel"
               Text="Text copiat!"
               FontSize="16"
               TextColor="White"
               BackgroundColor="#4B2E06"
               Padding="12,6"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               Opacity="0"
               IsVisible="False"
               ZIndex="999"/>
    </Grid>
</ContentPage>
