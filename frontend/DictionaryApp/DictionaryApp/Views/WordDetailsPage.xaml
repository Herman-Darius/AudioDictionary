<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DictionaryApp.Views.WordDetailsPage"
             BackgroundColor="#f4f4f9">

    <ContentPage.Resources>
        <!-- Button Style for Play Audio -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#4CAF50"/>
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="12, 8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="WidthRequest" Value="250"/>
            <Setter Property="HorizontalOptions" Value="Center"/>
            <Setter Property="HeightRequest" Value="50"/>
        </Style>

        <!-- Style for Phrases -->
        <Style x:Key="PhraseLabel" TargetType="Label">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="TextColor" Value="Black"/>
        </Style>

        <!-- Style for Hyperlinked Words -->
        <Style x:Key="HyperlinkedWord" TargetType="Label">
            <Setter Property="TextColor" Value="Blue"/>
            <Setter Property="TextDecorations" Value="Underline"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20">

            <!-- Word Information -->
            <Label Text="{Binding wordName}"
                   FontSize="24"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"/>
            <Label Text="{Binding definition}"
                   Style="{StaticResource PhraseLabel}"/>

            <!-- Play Audio Button -->
            <Button Text="Play Word Audio"
                    Style="{StaticResource PrimaryButton}"
                    Clicked="OnPlayAudioClicked"
                    IsEnabled="True"/>

            <!-- Direct Phrases Section -->
            <Label Text="Direct Phrases"
                   FontSize="20"
                   FontAttributes="Bold"
                   HorizontalOptions="Start"/>

            <StackLayout x:Name="DirectPhrasesStackLayoutInstance" Spacing="10">
                <!-- Direct phrases will be dynamically added here -->
            </StackLayout>

            <!-- Related Phrases Section -->
            <Label Text="Related Phrases"
                   FontSize="20"
                   FontAttributes="Bold"
                   HorizontalOptions="Start"/>

            <StackLayout x:Name="RelatedPhrasesStackLayoutInstance" Spacing="10">
                <!-- Related phrases will be dynamically added here -->
            </StackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
