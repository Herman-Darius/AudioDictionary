<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="DictionaryApp.Views.WordDetailsPage"
    BackgroundColor="#f4f4f9"
    Title="Word Details">

    <ContentPage.Resources>
        <!-- Section Title Style -->
        <Style x:Key="SectionHeader" TargetType="Label">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="TextColor" Value="#333"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
        <!-- Phrase Container Style -->
        <Style x:Key="PhraseContainer" TargetType="StackLayout">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Spacing" Value="10"/>
            <Setter Property="BackgroundColor" Value="#ffffff"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="HorizontalOptions" Value="FillAndExpand"/>
            <Setter Property="VerticalOptions" Value="Center"/>
            <Setter Property="MinimumHeightRequest" Value="60"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#4CAF50"/>
            <Setter Property="TextColor" Value="White"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="12, 8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="WidthRequest" Value="250"/>
            <Setter Property="HorizontalOptions" Value="Center"/>
            <Setter Property="HeightRequest" Value="50"/>
        </Style>

        <Style x:Key="PhraseLabel" TargetType="Label">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="TextColor" Value="Black"/>
        </Style>

        <Style x:Key="HyperlinkedWord" TargetType="Label">
            <Setter Property="TextColor" Value="Blue"/>
            <Setter Property="TextDecorations" Value="Underline"/>
        </Style>

        <Style x:Key="SmallButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="LightGray"/>
            <Setter Property="TextColor" Value="Black"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="WidthRequest" Value="40"/>
            <Setter Property="HeightRequest" Value="30"/>
            <Setter Property="HorizontalOptions" Value="End"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        
        <!-- Copy Button Style -->
        <Style x:Key="CopyButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#DDDDDD"/>
            <Setter Property="TextColor" Value="Black"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="WidthRequest" Value="40"/>
            <Setter Property="HeightRequest" Value="40"/>
            <Setter Property="CornerRadius" Value="20"/>
        </Style>
    </ContentPage.Resources>

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20">

            <!-- Word Information -->
            <Label Text="{Binding wordName}"
               FontSize="24"
               FontAttributes="Bold"
               HorizontalOptions="Center"/>
            <Label Text="{Binding definition}"
               Style="{StaticResource PhraseLabel}"/>

            <!-- Buttons in the same row -->
            <StackLayout Orientation="Horizontal"
                     HorizontalOptions="Center"
                     Spacing="20">

                <!-- Play Audio Button -->
                <Button Text="🔊"
                    FontSize="24"
                    WidthRequest="60"
                    HeightRequest="60"
                    CornerRadius="30"  
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    Style="{StaticResource PrimaryButton}"
                    Clicked="OnPlayAudioClicked"/>

                    <!-- Copy Button (Next to Word) -->
                    <Button Text="📋"
                    FontSize="24"
                    WidthRequest="60"
                    HeightRequest="60"
                    CornerRadius="30"
                    BackgroundColor="#4CAF50"
                    TextColor="White"
                    Style="{StaticResource CopyButton}"
                    Clicked="OnCopyWordClicked"/>

            </StackLayout>

            <!-- Direct Phrases Section -->
            <Label Text="Direct Phrases" Style="{StaticResource SectionHeader}" />
            <StackLayout x:Name="DirectPhrasesStackLayoutInstance"></StackLayout>

            <!-- Related Phrases Section -->
            <Label Text="Related Phrases" Style="{StaticResource SectionHeader}" />
            <StackLayout x:Name="RelatedPhrasesStackLayoutInstance"></StackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
